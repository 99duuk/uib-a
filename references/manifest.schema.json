{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "project", "viewports", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"type":"object","required":["key","title"],"properties":{"key":{"type":"string","minLength":1},"title":{"type":"string","minLength":1}}},
    "viewports": {"type":"array","minItems":1,"items":{"type":"object","required":["id","width","height"],"properties":{"id":{"type":"string","minLength":1},"width":{"type":"integer","minimum":240,"maximum":8000},"height":{"type":"integer","minimum":240,"maximum":12000},"dpr":{"type":"number","minimum":1,"maximum":4}}}},
    "entries": {"type":"array","minItems":1,"items":{"type":"object","required":["id","screen","state","viewport","title","after"],"properties":{"id":{"type":"string","minLength":1},"screen":{"type":"string","minLength":1},"state":{"type":"string","minLength":1},"viewport":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"after":{"type":"object","required":["file","revision"],"properties":{"file":{"type":"string","minLength":1},"revision":{"type":"string","minLength":1}}},"before":{"type":"object","required":["revision","kind"],"properties":{"revision":{"type":"string","minLength":1},"kind":{"enum":["dom","manual","image","missing"]},"capture":{"type":"string"},"image":{"type":"string"},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}}}}}},
    "research": {"type":"array"},
    "brand": {"type":"object"},
    "coverage": {"type":"object"},
    "previousBundle": {"type":"string"},
    "reviewState": {"type":"string"}
  }
}
