{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "targets"
  ],
  "properties": {
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "resume": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "colorScheme": {
      "enum": [
        "light",
        "dark",
        "no-preference"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]+$"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "dpr": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4
          },
          "deadlineMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000
          },
          "mask": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w.-]+$"
                },
                "label": {
                  "type": "string"
                },
                "scroll": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "end": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "sourceRevision": {
            "type": "string"
          },
          "fixtureVersion": {
            "type": "string"
          },
          "fixtureFile": {
            "type": "string"
          },
          "storageState": {
            "type": "string"
          },
          "ready": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark",
              "no-preference"
            ]
          }
        }
      }
    }
  }
}
